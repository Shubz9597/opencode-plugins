{
  "name": "opencode-remote-ui",
  "version": "0.1.0",
  "description": "opencode plugin that serves a mobile-friendly web UI on your Tailscale network (or localhost) so you can send messages to opencode sessions remotely",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tailscale",
    "remote",
    "web-ui"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@opencode-ai/sdk": "^1.18.31",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
